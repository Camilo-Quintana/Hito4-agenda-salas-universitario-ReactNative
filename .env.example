# Dirección de la API del Hito 3 que usará la app.
# Copia este archivo como .env solo si necesitas fijarla (si no, la app la calcula sola: ver src/config.js).
#
# Emulador de Android, con la API corriendo en el mismo computador:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Celular con Expo Go en la misma red Wi-Fi (usa la IP de tu computador: ipconfig / ip addr):
#   EXPO_PUBLIC_API_URL=http://192.168.1.15:3000/api
# API desplegada en un servidor:
#   EXPO_PUBLIC_API_URL=https://mi-api.onrender.com/api

EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
